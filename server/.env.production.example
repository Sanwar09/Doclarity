PORT=5000
NODE_ENV=production
AUTH_JWT_SECRET=replace_with_a_long_random_secret

# CORS
ALLOWED_ORIGIN=https://your-domain.com

# Chat + analysis provider
LLM_PROVIDER=gemini
USE_OLLAMA_FOR_ANALYZE=false

# Gemini fallback / primary
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL_ID=gemini-2.5-flash

# Optional Ollama configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=90000
REASONING_MODELS=qwen2.5:7b,deepseek-r1:8b,llama3.1:8b
ENABLE_EMBEDDINGS_FOR_LONG_DOCS=true
OLLAMA_EMBED_MODEL=nomic-embed-text

# Analysis options
ANALYZE_ENGINE=hybrid
ANALYZE_DEBUG=false

# Python / spaCy
PYTHON_BIN=python3
SPACY_TIMEOUT_MS=10000

# Google auth
GOOGLE_CLIENT_ID=replace_with_google_client_id
